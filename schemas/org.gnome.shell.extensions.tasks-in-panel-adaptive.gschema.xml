<?xml version='1.0' encoding='utf-8'?>
<schemalist>
  <schema id="org.gnome.shell.extensions.tasks-in-panel-adaptive" path="/org/gnome/shell/extensions/tasks-in-panel-adaptive/">
    <key type="b" name="container-fill-space">
      <default>false</default>
      <summary>Expand the container into unused panel space</summary>
    </key>
    <key type="b" name="dynamic-task-display">
      <default>true</default>
      <summary>Show window titles only when visible tasks contain duplicate applications</summary>
    </key>
    <key type="b" name="show-window-icon">
      <default>true</default>
      <summary>Show window icon inside task button</summary>
    </key>
    <key type="b" name="show-window-title">
      <default>true</default>
      <summary>Show window title inside task button</summary>
    </key>
    <key type="b" name="show-window-app">
      <default>false</default>
      <summary>Show application name inside task button</summary>
    </key>
    <key type="b" name="show-active-workspace">
      <default>true</default>
      <summary>Show windows on active workspace only</summary>
    </key>
    <key type="b" name="show-panel-monitor-only">
      <default>true</default>
      <summary>Show windows on the panel monitor only</summary>
    </key>
    <key type="b" name="show-focused-window">
      <default>false</default>
      <summary>Show task for focused window only</summary>
    </key>
    <key type="b" name="group-windows">
      <default>false</default>
      <summary>Group windows by app</summary>
    </key>
    <key type="i" name="hover-delay">
      <default>300</default>
      <summary>Hover action delay</summary>
      <range min="0" max="2000" />
    </key>
    <key type="b" name="desaturate-icon">
      <default>false</default>
      <summary>Monochrome icon</summary>
    </key>
    <key type="i" name="button-width">
      <default>-1</default>
      <summary>Maximum task width</summary>
      <range min="-1" max="4096" />
    </key>
    <key type="b" name="animate-on-close">
      <default>true</default>
      <summary>Animate on close</summary>
    </key>
    <key name="middle-click-close" type="b">
      <default>true</default>
      <summary>Close the represented window on task middle-click</summary>
    </key>
    <key name="preview-height" type="i">
      <default>160</default>
      <range min="80" max="320" />
      <summary>Maximum window thumbnail height in logical pixels</summary>
    </key>
    <key name="migration-complete" type="b">
      <default>false</default>
    </key>
    <key name="container-position" type="s">
      <default>'left'</default>
      <choices>
        <choice value="left" />
        <choice value="center" />
        <choice value="right" />
      </choices>
    </key>
    <key name="container-font-weight" type="s">
      <default>'theme'</default>
      <choices>
        <choice value="theme" />
        <choice value="normal" />
        <choice value="bold" />
      </choices>
    </key>
    <key name="container-custom-background" type="b">
      <default>false</default>
    </key>
    <key name="container-background-color" type="s">
      <default>'rgba(0,0,0,0.5)'</default>
    </key>
    <key name="container-scroll" type="b">
      <default>true</default>
    </key>
    <key name="hover-action" type="s">
      <default>'preview'</default>
      <choices>
        <choice value="none" />
        <choice value="raise" />
        <choice value="preview" />
      </choices>
    </key>
  </schema>
</schemalist>